# Required for database access
DATABASE_URL=postgresql://your_local_db_user:your_local_db_password@localhost:5432/your_local_db_name

# Required for utility bill parsing; leave blank if you are not using OpenAI-based extraction
OPENAI_API_KEY=your_openai_api_key_here

# Required for Auth0 JWT validation
AUTH0_DOMAIN=your-auth0-domain.us.auth0.com
AUTH0_API_AUDIENCE=https://your-api-identifier
https://your-api-identifier

# Optional: defaults to RS256 in code if omitted
AUTH0_ALGORITHMS=RS256

# Optional: defaults to http://localhost:5173 if omitted
ALLOWED_ORIGINS=http://localhost:5173
# for email role feature, you need to set up an SMTP server and provide the following configuration values
# Invitation sending will return an error until SMTP is configured
# this is utilizing gmail SMTP, but you can use any SMTP server that supports TLS as long as you alter the SMTP_HOST and SMTP_PORT values accordingly
# fyi i haven't fully tested the functionality of the email feature
# and the compatibility with other SMTP servers, so if you run into issues, please let me know and I can help troubleshoot -bihan
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=your-email@gmail.com
FRONTEND_URL=http://localhost:5173